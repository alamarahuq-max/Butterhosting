#!/bin/sh
# ButterOS screen on tty1: graphical HUD if a framebuffer exists, else the text HUD, else the plain menu.
export TERM=${TERM:-linux}
# let the machine finish booting first (shows the same loading screen as the menu)
if grep -q 'butter=install' /proc/cmdline 2>/dev/null; then exec /usr/local/bin/butter-tui-lite; fi
i=0; while [ $i -lt 30 ] && ! wget -q -O /dev/null http://127.0.0.1/cgi-bin/api?a=ping 2>/dev/null; do sleep 1; i=$((i+1)); done
if command -v node >/dev/null 2>&1; then
  if [ -e /dev/fb0 ] && [ "$BUTTER_UI" != text ]; then
    while :; do node /usr/local/lib/butter/gui.js; rc=$?; [ $rc -eq 3 ] && break; sleep 1; done
  fi
  if [ -t 0 ]; then
    while :; do node /usr/local/lib/butter/tui.js; rc=$?; [ $rc -eq 3 ] && break; sleep 1; done
  fi
fi
exec /usr/local/bin/butter-tui-lite
