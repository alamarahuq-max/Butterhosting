#!/bin/sh
# Loads the out-of-tree RTL8188EU driver when such an adapter is plugged in and the kernel has no driver for it.
modprobe cfg80211 2>/dev/null
K=/usr/lib/butter/8188eu.ko; [ -f "$K" ] || exit 0
grep -q '^8188eu ' /proc/modules 2>/dev/null && exit 0
# if the kernel's own driver (rtl8xxxu) already took the adapter, leave it alone: two drivers fighting over one adapter makes it drop off the bus
ls /sys/bus/usb/drivers/rtl8xxxu/ 2>/dev/null | grep -q '^[0-9]' && exit 0
ls /sys/class/net/*/wireless -d 2>/dev/null | grep -q . && exit 0
# the module only binds to its own USB ids, so loading it is harmless when nothing matches
insmod "$K" 2>/dev/null
exit 0
