#!/bin/sh
# Offers a login-free shell on the serial port, but only when a real serial port exists
# (also used by the automatic tests). Sleeps forever otherwise so init does not respawn-loop.
PATH=/usr/local/bin:/usr/local/sbin:/usr/sbin:/sbin:/usr/bin:/bin; export PATH
if grep -E '^0:.*uart:' /proc/tty/driver/serial 2>/dev/null | grep -vq 'uart:unknown'; then
  exec /sbin/getty -n -l /bin/sh -L 115200 ttyS0 vt100
fi
exec sleep 2147483647
