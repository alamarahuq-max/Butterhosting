#!/bin/sh
# ButterOS Wi-Fi menu: pick a network, type the password once. After that it reconnects by itself on every boot.
modprobe cfg80211 2>/dev/null; /usr/lib/butter/load-wifi 2>/dev/null
IF=""; i=0
dialog --infobox "Looking for a Wi-Fi adapter ...\n\n(USB adapters can take up to 15 seconds)" 6 50
while [ $i -lt 15 ]; do butter-net status | grep -q '"wifi_adapter":true' && { IF=1; break; }; sleep 1; i=$((i+1)); done
[ -n "$IF" ] || { dialog --title "No Wi-Fi adapter found" --msgbox "Plug the adapter straight into a USB port on the back of the machine (not a hub) and try again.\n\nA network cable works with no setup." 12 64; exit 1; }
dialog --infobox "Scanning for networks ..." 5 40
LIST=$(butter-net scan | tr '{' '\n' | sed -n 's/.*"ssid":"\([^"]*\)","signal":\(-\?[0-9]*\),"security":"\([a-z]*\)".*/\1|\2|\3/p')
[ -n "$LIST" ] || { dialog --msgbox "No networks found. Move closer to the router and try again." 8 56; exit 1; }
set --; while IFS='|' read -r s l p; do set -- "$@" "$s" "$p, signal $l"; done <<EOF
$LIST
EOF
SSID=$(dialog --stdout --title "Choose your Wi-Fi" --menu "" 20 64 12 "$@") || exit 0
PASS=""; SEC=$(echo "$LIST" | awk -F'|' -v s="$SSID" '$1==s{print $3; exit}')
[ "$SEC" = open ] || PASS=$(dialog --stdout --insecure --passwordbox "Password for $SSID" 8 56) || exit 0
dialog --infobox "Connecting to $SSID ..." 5 50
R=$(butter-net join "$SSID" "$PASS")
case "$R" in *'"ok":true'*) dialog --msgbox "Connected. It will reconnect by itself next time." 7 52;; *) dialog --msgbox "$(echo "$R" | sed 's/.*"error":"\([^"]*\)".*/\1/')" 8 60;; esac
