#!/bin/sh
# ButterOS Wi-Fi: scan, pick a network, type the password, connect. Works with any adapter the kernel has a driver for.
command -v iw >/dev/null 2>&1 || { echo "Wi-Fi tools are not in this build."; sleep 3; exit 1; }
export DIALOGRC=/etc/butter.dialogrc
modprobe cfg80211 2>/dev/null; [ -x /usr/lib/butter/load-wifi ] && /usr/lib/butter/load-wifi
findif() { ls /sys/class/net 2>/dev/null | while read n; do [ -d /sys/class/net/$n/wireless ] || [ -d /sys/class/net/$n/phy80211 ] && echo $n; done | head -1; }
IF=$(findif)
if [ -z "$IF" ]; then
  # a USB adapter may have been plugged in only seconds ago, or its driver is not loaded yet: try everything, then wait
  dialog --infobox "Looking for a Wi-Fi adapter ...\n\n(USB adapters can take up to 15 seconds)" 6 50
  for d in /sys/bus/usb/devices/*; do [ -f "$d/modalias" ] && modprobe -b "$(cat $d/modalias)" 2>/dev/null; done
  for d in /sys/bus/usb/devices/*:*; do [ -f "$d/modalias" ] && modprobe -b "$(cat $d/modalias)" 2>/dev/null; done
  grep -q '^8188eu ' /proc/modules 2>/dev/null || { [ -f /usr/lib/butter/8188eu.ko ] && insmod /usr/lib/butter/8188eu.ko 2>/dev/null; }
  i=0; while [ $i -lt 15 ] && [ -z "$IF" ]; do IF=$(findif); [ -n "$IF" ] || sleep 1; i=$((i+1)); done
fi
if [ -z "$IF" ]; then
  R=/run/butter-wifi-report.txt
  { echo "USB devices seen:"; for d in /sys/bus/usb/devices/[0-9]*-[0-9.]*; do [ -f "$d/idVendor" ] || continue; case "$(basename $d)" in *:*) continue;; esac
      b=$(basename $d); drv=none; for i in $d/*:*; do [ -L "$i/driver" ] && drv=$(basename $(readlink $i/driver)); done
      echo " $(cat $d/idVendor):$(cat $d/idProduct)  $(cat $d/manufacturer 2>/dev/null) $(cat $d/product 2>/dev/null)  driver=$drv"; done
    echo; echo "Kernel messages:"; dmesg 2>/dev/null | grep -iE "usb|firmware|8188|rtl|wlan|wifi|cfg80211" | tail -12; } > $R 2>&1
  H=""; if dmesg 2>/dev/null | grep -q "USB disconnect"; then dmesg | grep -qiE "rtl|8188|wlan" && H="The adapter was seen and then dropped off the USB port by itself. That is almost always power: plug it straight into a USB port on the back of the machine (not a hub, a keyboard, or the front panel) and try again.\n\n"; fi
  dialog --title "No Wi-Fi adapter found" --msgbox "$H$(cat $R | cut -c1-70)\n\nIf your adapter is listed above with driver=none, this ButterOS build has no driver for it yet: send this screen (photo) with the adapter name. A network cable works with no setup." 24 76; exit 1
fi
ip link set "$IF" up 2>/dev/null; rfkill unblock all 2>/dev/null
dialog --infobox "Scanning for networks on $IF ..." 4 44
iw dev "$IF" scan 2>/dev/null > /tmp/scan.txt; sleep 1; [ -s /tmp/scan.txt ] || { iw dev "$IF" scan 2>/dev/null > /tmp/scan.txt; }
awk '/^BSS /{if(s!="")print sig"\t"s; s=""; sig=-100} /signal:/{sig=$2} /SSID:/{sub(/^[ \t]*SSID: /,""); s=$0} END{if(s!="")print sig"\t"s}' /tmp/scan.txt | sort -rn | awk -F'\t' '$2!=""&&!seen[$2]++{printf "%s\n%s dBm\n",$2,$1}' > /tmp/nets.txt
[ -s /tmp/nets.txt ] || { dialog --msgbox "No networks found. Move closer to the router and try again." 7 56; exit 1; }
set --; while IFS= read -r a && IFS= read -r b; do set -- "$@" "$a" "$b"; done < /tmp/nets.txt
SSID=$(dialog --stdout --menu "Pick your Wi-Fi network" 20 64 12 "$@") || exit 0
PASS=$(dialog --stdout --insecure --passwordbox "Password for $SSID (empty if it is open)\n(shown as ***; letters are case-sensitive)" 10 64) || exit 0
mkdir -p /etc/wpa_supplicant
if [ -n "$PASS" ]; then
  L=$(printf %s "$PASS" | wc -c)
  [ "$L" -ge 8 ] && [ "$L" -le 63 ] || { dialog --msgbox "A Wi-Fi password must be 8 to 63 characters (you typed $L).\nTry again." 8 56; exit 1; }
  printf 'ctrl_interface=/run/wpa_supplicant\nupdate_config=1\n' > /etc/wpa_supplicant/wpa_supplicant.conf
  wpa_passphrase "$SSID" "$PASS" | grep -v '#psk' >> /etc/wpa_supplicant/wpa_supplicant.conf
else printf 'network={\n ssid="%s"\n key_mgmt=NONE\n}\n' "$SSID" > /etc/wpa_supplicant/wpa_supplicant.conf; fi
grep -q 'network={' /etc/wpa_supplicant/wpa_supplicant.conf || { dialog --msgbox "Could not save this network (odd characters in the name or password?)." 7 60; exit 1; }
chmod 600 /etc/wpa_supplicant/wpa_supplicant.conf
touch /run/butter-wifi.busy; pkill wpa_supplicant 2>/dev/null; pkill -f "udhcpc.*$IF" 2>/dev/null; sleep 1
rm -f /run/wpa_supplicant/"$IF" /tmp/wpa.log; ip addr flush dev "$IF" 2>/dev/null; ip link set "$IF" up 2>/dev/null
dialog --infobox "Connecting to $SSID ..." 4 44
wpa_supplicant -B -i "$IF" -c /etc/wpa_supplicant/wpa_supplicant.conf -f /tmp/wpa.log -t >/dev/null 2>&1
i=0; while [ $i -lt 30 ]; do iw dev "$IF" link 2>/dev/null | grep -q Connected && break; grep -qE "WRONG_KEY|4-Way Handshake failed|pre-shared key may be incorrect" /tmp/wpa.log 2>/dev/null && break; sleep 1; i=$((i+1)); done
LINKED=0; iw dev "$IF" link 2>/dev/null | grep -q Connected && LINKED=1
[ $LINKED = 1 ] && { dialog --infobox "Connected. Getting an address from the router ..." 4 54; udhcpc -i "$IF" -q -n -t 8 >/dev/null 2>&1; }
rm -f /run/butter-wifi.busy
IP=$(ip -4 -o addr show dev "$IF" 2>/dev/null | awk '{print $4}' | cut -d/ -f1)
if [ -n "$IP" ]; then
  dialog --msgbox "Connected to $SSID.\n\nThis machine: $IP\nOpen http://$IP on your phone." 9 56
elif [ $LINKED = 1 ]; then
  dialog --msgbox "Connected to $SSID, but the router did not give this machine an address (DHCP).\nTry again, or restart the router." 9 60; exit 1
elif grep -qE "WRONG_KEY|4-Way Handshake failed|pre-shared key may be incorrect" /tmp/wpa.log 2>/dev/null; then
  dialog --msgbox "The router refused the password for $SSID.\nRetype it carefully (case matters)." 8 60; exit 1
else
  dialog --title "Could not connect to $SSID" --msgbox "No answer from the router (this is not necessarily the password).\n\n$(tail -6 /tmp/wpa.log 2>/dev/null | cut -c1-72)\n\nMove closer, or check the network is 2.4 GHz (most small USB adapters cannot use 5 GHz)." 17 76; exit 1
fi
