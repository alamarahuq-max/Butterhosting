#!/bin/sh
# ButterOS console: the screen you see on the machine. Needs: dialog, docker.
ENVF=/etc/butterhosting.env
if ! command -v dialog >/dev/null 2>&1; then echo 'ButterOS: menu package missing from this build. Dropping to a shell.'; exec /bin/sh; fi
for f in /usr/share/consolefonts/ter-v24n.psf.gz /usr/share/consolefonts/ter-v20n.psf.gz /usr/share/consolefonts/ter-v16n.psf.gz; do [ -f "$f" ] && { setfont "$f" 2>/dev/null && break; }; done
export DIALOGRC=/etc/butter.dialogrc; export TERM=${TERM:-linux}
Y=$(printf '\033[1;33m'); D=$(printf '\033[2;37m'); W=$(printf '\033[1;37m'); G=$(printf '\033[1;32m'); R0=$(printf '\033[0m'); BL=$(printf '\033[1;34m')
ip4() { ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1; }
count() { docker ps -q --filter label=butterhosting=1 2>/dev/null | wc -l; }
memline() { free -m | awk '/Mem:/ {printf "%d / %d MB", $3, $2}'; }
ask() { cur=$(grep "^$1=" "$ENVF" 2>/dev/null | cut -d= -f2-); val=$(dialog --stdout --inputbox "$2" 9 66 "$cur") || return 1
  touch "$ENVF"; chmod 600 "$ENVF"; grep -v "^$1=" "$ENVF" > "$ENVF.tmp"; echo "$1=$val" >> "$ENVF.tmp"; mv "$ENVF.tmp" "$ENVF"; }
center() { # print $1 centered on the screen, plain text length given by $2
  c=$(tput cols 2>/dev/null || echo 80); pad=$(( (c - $2) / 2 )); [ $pad -lt 0 ] && pad=0; printf '%*s%s\n' $pad '' "$1"; }
BANNER='█████▄ ██  ██ ██████ ██████ ██████ █████▄    ▄████▄ ▄█████
██  ██ ██  ██   ██     ██   ██     ██  ██    ██  ██ ██
█████▀ ██  ██   ██     ██   ████   █████▀    ██  ██ ▀████▄
██  ██ ██  ██   ██     ██   ██     ██ ▀█▄    ██  ██     ██
█████▀ ▀████▀   ██     ██   ██████ ██  ▀█    ▀████▀ █████▀'
home() {
  clear; cols=$(tput cols 2>/dev/null || echo 80)
  printf '\n'
  if [ "$cols" -ge 62 ]; then
    printf '%s\n' "$BANNER" | while IFS= read -r l; do center "$Y$l$R0" 58; done
  else center "${Y}Butter Os${R0}" 9; fi
  printf '\n'; center "${D}Minecraft hosting. Nothing else.${R0}" 31; printf '\n'
  center "${W}$(count)${R0} ${D}servers${R0}     ${W}$(memline)${R0} ${D}memory${R0}     ${D}web page${R0} ${G}http://$(ip4)${R0}" 62
  [ -f /run/butter-persist ] && s="${G}storage ready${R0}" || s="${D}no BUTTER volume: everything is in RAM${R0}"
  center "$s" 36; printf '\n'
  for l in "1  Play with friends" "2  Open the web page" "3  Install ButterOS on this PC" "4  Connect to my site" "5  Be a backup node" "6  Power off" "7  Restart"; do
    k=${l%%  *}; t=${l#*  }; printf '%*s%s\n' $(( (cols - 32) / 2 )) '' "${Y}${k}${R0}   ${W}${t}${R0}"; done
  printf '\n'; center "${D}press a number${R0}" 14
}
play() { clear; /usr/local/bin/butter-play; printf '\nPress Enter to go back '; read x; }
loading() { clear; cols=$(tput cols 2>/dev/null || echo 80); printf '\n\n'
  if [ "$cols" -ge 62 ]; then printf '%s\n' "$BANNER" | while IFS= read -r l; do center "$Y$l$R0" 58; done; else center "${Y}Butter Os${R0}" 9; fi
  printf '\n'; center "${D}starting up${R0}" 11; printf '\n'
  i=0; while [ $i -lt 40 ]; do
    docker info >/dev/null 2>&1 && wget -q -O /dev/null http://127.0.0.1/cgi-bin/api?a=ping 2>/dev/null && break
    f=$(( i % 20 )); b=$(printf '%*s' $f '' | tr ' ' '#'); printf '\r%*s[%-20s]' $(( (cols - 22) / 2 )) '' "$b"; sleep 1; i=$((i+1)); done
  printf '\r%*s[%s]\n' $(( (cols - 22) / 2 )) '' "####################"; sleep 1; }
loading
if grep -q 'butter=install' /proc/cmdline 2>/dev/null; then /usr/local/bin/butter-install; fi
while :; do
  home; c=""; read -r -t 5 -n 1 c || continue
  case $c in
    1) play ;;
    2) dialog --msgbox "Open this on any phone or computer on your network:\n\n  http://$(ip4)\n\nIt shows memory and your servers, and lets you start, stop and make servers." 12 60 ;;
    3) clear; /usr/local/bin/butter-install; printf "\nPress Enter to go back "; read x ;;
    4) ask DISCORD_CLIENT_ID "Discord application client ID" && ask DISCORD_CLIENT_SECRET "Discord client secret" && ask FRONTEND_URL "Your site, e.g. https://your-site.vercel.app" && { rc-service butterhosting restart >/dev/null 2>&1; dialog --msgbox "Saved." 6 30; } ;;
    5) dialog --yesno "This machine can run the site's servers when the main server (Codespace) is asleep, then hand everything back. You need: the private GitHub repo name, a GitHub token for it (contents: read+write) and the SAME session secret the main server uses. Continue?" 12 66 && \
       ask REGISTRY_REPO "owner/repo (private)" && ask REGISTRY_TOKEN "GitHub token (contents read+write)" && ask SESSION_SECRET "Same SESSION_SECRET as the Codespace" && {
         grep -v "^BUTTER_ROLE=" "$ENVF" > "$ENVF.tmp"; echo BUTTER_ROLE=device >> "$ENVF.tmp"; mv "$ENVF.tmp" "$ENVF"
         rc-service butterhosting restart >/dev/null 2>&1; rc-service butterfailover restart >/dev/null 2>&1
         dialog --msgbox "Backup mode is on. This machine waits quietly and takes over only if the main server stops answering." 8 60; } ;;
    6) poweroff ;;
    7) reboot ;;
  esac
done
