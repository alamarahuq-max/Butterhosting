#!/bin/sh
# ButterOS network daemon (replaces NetworkManager). Every few seconds it:
#  1. loads drivers for any USB/PCI device that appeared (Wi-Fi adapters included),
#  2. brings every cable port up and asks DHCP for an address when a cable is plugged in,
#  3. joins the saved Wi-Fi network (wpa_supplicant) and asks DHCP once it is associated.
LOG=/var/log/butter-wifid.log; SEEN=/run/butter-wifi.seen; : > "$SEEN"
CONF=/etc/wpa_supplicant/wpa_supplicant.conf
log() { echo "$(date +%T) $*" >> "$LOG"; }
alive() { [ -s "$1" ] && kill -0 "$(cat "$1")" 2>/dev/null; }
dhcp() { alive "/run/udhcpc.$1.pid" || { log "asking DHCP on $1"; udhcpc -i "$1" -b -t 6 -T 3 -S -p "/run/udhcpc.$1.pid" >/dev/null 2>&1; }; }
modprobe cfg80211 2>/dev/null; modprobe mac80211 2>/dev/null
log "started"
while :; do
  for f in /sys/bus/usb/devices/*/modalias /sys/bus/usb/devices/*/*/modalias /sys/bus/pci/devices/*/modalias; do
    [ -f "$f" ] || continue
    grep -qxF "$f" "$SEEN" 2>/dev/null && continue
    echo "$f" >> "$SEEN"; m=$(cat "$f" 2>/dev/null); [ -n "$m" ] || continue
    modprobe -b "$m" >/dev/null 2>&1 && log "driver for $m loaded"
  done
  /usr/lib/butter/load-wifi 2>/dev/null
  for n in /sys/class/net/*; do
    i=${n##*/}
    case "$i" in lo|docker*|veth*|br-*|virbr*|bore*|tun*|tap*|dummy*|sit*|ip6*) continue;; esac
    ip link set "$i" up 2>/dev/null
    if [ -d "$n/wireless" ] || [ -d "$n/phy80211" ]; then
      if ! grep -qxF "iface:$i" "$SEEN" 2>/dev/null; then echo "iface:$i" >> "$SEEN"; log "wifi adapter ready: $i"; echo "$i" > /run/butter-wifi.new; fi
      grep -q 'network={' "$CONF" 2>/dev/null || continue
      alive "/run/wpa.$i.pid" || { log "joining saved Wi-Fi on $i"; mkdir -p /run/wpa_supplicant; wpa_supplicant -B -i "$i" -c "$CONF" -P "/run/wpa.$i.pid" >/dev/null 2>&1; }
      iw dev "$i" link 2>/dev/null | grep -q '^Connected' && dhcp "$i"
    else
      [ "$(cat "$n/carrier" 2>/dev/null)" = 1 ] && dhcp "$i"
    fi
  done
  sleep 3
done
