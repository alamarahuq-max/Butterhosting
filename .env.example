# Copy these into GitHub: Settings -> Codespaces -> Secrets (give them access to this repo).
# For local testing you can also export them in your shell.

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Your Vercel site, no trailing slash. Comma-separate to allow more than one.
FRONTEND_URL=https://your-site.vercel.app

# Any long random string (openssl rand -hex 32). If empty, one is generated and kept in backend/data.
SESSION_SECRET=

# Discord user IDs with no server limit, comma-separated. Optional.
ADMIN_DISCORD_IDS=

# Hostname players use to reach game servers (a tunnel or domain pointing at this machine). Optional.
PUBLIC_HOST=

# Optional tuning
MAX_SERVERS_PER_USER=3
