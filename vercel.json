{
 "framework": null,
 "cleanUrls": true,
 "headers": [
  {
   "source": "/fonts/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  }
 ],
 "rewrites": [
  {
   "source": "/relay/:path*",
   "destination": "/api/relay?p=:path*"
  }
 ]
}